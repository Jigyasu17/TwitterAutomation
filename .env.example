# Application Configuration
APP_NAME=MarketPulse
ENV=development
PORT=8000
HOST=127.0.0.1

# Database Configuration
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///data/marketpulse.db

# Firestore Configuration (For DATABASE_BACKEND=firestore)
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_CREDENTIALS_JSON=your-service-account-json-content-or-file-path

# Production Auth (required in Vercel production env vars; ignored when ENV=development)
# CRON_SECRET is sent automatically by Vercel Cron as "Authorization: Bearer <value>"
# once this env var is set on the project — protects /api/jobs/*.
# ADMIN_SECRET protects manual mutating endpoints (collect/process/approve/reject/research);
# callers must send the same value as "Authorization: Bearer <value>".
CRON_SECRET=
ADMIN_SECRET=

# Scheduler & Fetching Configuration
NEWS_FETCH_INTERVAL_MINUTES=15
MAX_STORIES_PER_RUN=100
MAX_AI_STORIES_PER_DAY=20
MIN_IMPORTANCE_SCORE=70

# AI Provider Configuration (For future milestones)
AI_PROVIDER=none
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Branding & Social Configuration
ACCOUNT_NAME=MarketPulse
ACCOUNT_HANDLE=marketpulse
IMAGE_WIDTH=1600
IMAGE_HEIGHT=900
